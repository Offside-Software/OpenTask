# ==========================================
# OpenTask API Configuration
# ==========================================

# --- Supabase & PostgreSQL ---
# Supabase Project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# PostgreSQL connection string (Supabase Transaction Pooler recommended)
# e.g.: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
POSTGRESQL_DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/postgres

# Optional direct DB credentials (if POSTGRESQL_DATABASE_URL is not set):
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=
POSTGRESQL_DATABASE=postgres

# --- GitHub App & OAuth (Direct OAuth) ---
GH_APP_ID=your_github_app_id
GH_APP_CLIENT_ID=your_github_oauth_client_id
GH_APP_CLIENT_SECRET=your_github_oauth_client_secret
GH_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
FRONTEND_URL=http://127.0.0.1:5173

# GitHub App Webhook and PEM Private Key (required for PR reviews):
GH_WEBHOOK_SECRET=your_github_webhook_secret
GH_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# --- AI Models & External Services ---
GEMINI_API_KEY=your_gemini_api_key
RECALL_API_KEY=your_recall_ai_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- App Security & Redis ---
SECRET_KEY=replace-this-with-a-secure-random-key
REDIS_URL=redis://localhost:6379/0

