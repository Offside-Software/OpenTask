# ==============================================================================
# OpenTask Environment Configuration
# ==============================================================================

# API Base URL for Frontend (opentask-app)
# Options:
# 1. Leave blank / unset:
#    - In local dev: Proxies to http://127.0.0.1:8000 via Vite dev server.
#    - On Vercel: Uses Vercel rewrites in vercel.json pointing to DewaCloud (https://env-opentask.user.cloudjkt02.com).
# 2. Set to a custom endpoint (e.g. for staging, preview, or testing):
#    - Example: VITE_API_BASE_URL=https://env-opentask.user.cloudjkt02.com
#    - Example: VITE_API_BASE_URL=http://localhost:8000
#
# Note: On Vercel, set this in: Project Settings -> Environment Variables -> VITE_API_BASE_URL
VITE_API_BASE_URL=https://env-opentask.user.cloudjkt02.com
