# ==============================================================================
# OpenTask Environment Configuration
# ==============================================================================

# ==========================================
# API Base URL for Frontend (opentask-app)
# ==========================================
# Options:
# 1. Leave blank / unset:
#    - In local dev: Proxies to http://127.0.0.1:8000 via Vite dev server.
#    - On Vercel: Uses Vercel rewrites in vercel.json pointing to DewaCloud (https://env-opentask.user.cloudjkt02.com).
# 2. Set to a custom endpoint (e.g. for staging, preview, or testing):
#    - Example: VITE_API_BASE_URL=https://env-opentask.user.cloudjkt02.com
#    - Example: VITE_API_BASE_URL=http://localhost:8000
#
# Note: On Vercel, set this in: Project Settings -> Environment Variables -> VITE_API_BASE_URL
VITE_API_BASE_URL=https://env-opentask.user.cloudjkt02.com


# ==========================================
# OpenTask API Configuration
# ==========================================

# --- Supabase & PostgreSQL ---
# Supabase Project credentials
SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
SUPABASE_KEY=<YOUR_SUPABASE_KEY>

# PostgreSQL connection string (Supabase Transaction Pooler recommended)
# e.g.: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
POSTGRESQL_DATABASE_URL=postgresql://postgres.<project-ref>>:<db_password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Optional direct DB credentials (if POSTGRESQL_DATABASE_URL is not set):
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=
POSTGRESQL_DATABASE=postgres

# --- GitHub App & OAuth (Direct OAuth) ---
GH_APP_ID=<GITHUB_APP_ID>
GH_APP_CLIENT_ID=<GITHUB_CLIENT_ID>
GH_APP_CLIENT_SECRET=<GITHUB_CLIENT_SECRET>
GH_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
FRONTEND_URL=http://localhost:5173

# GitHub App Webhook and PEM Private Key (required for PR reviews):
GH_WEBHOOK_SECRET=<GITHUB_WEBHOOK_SECRET>
# USE \n (backslash n) no new lines
GH_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n<YOUR_KEY>\n-----END RSA PRIVATE KEY-----

# --- AI Models & External Services ---
GEMINI_API_KEY=<YOUR_GEMINI_KEY>
RECALL_API_KEY=your_recall_ai_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- App Security & Redis ---
SECRET_KEY=replace-this-with-a-secure-random-key
REDIS_URL=redis://localhost:6379/0

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=<YOUR_VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<YOUR_VAPID_PRIVATE_KEY>
VAPID_CLAIM_EMAIL=mailto:<YOUR_CLAIM_EMAIL>
