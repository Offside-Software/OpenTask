{
  "version": 2,
  "regions": ["sin1", "bom1"],
  "buildCommand": "cd opentask-app && bun install && bun run build",
  "outputDirectory": "opentask-app/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}