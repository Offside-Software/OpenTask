# ==========================================
# Equilibra Frontend Configuration
# ==========================================

# Supabase public credentials (optional if querying directly from frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-auth-client-id
VITE_GOOGLE_OAUTH_CLIENT_SECRET=your-google-auth-client-secret

# Backend API URL (defaults to http://localhost:8000 via Vite proxy or apiClient)
VITE_API_BASE_URL=http://localhost:8000
