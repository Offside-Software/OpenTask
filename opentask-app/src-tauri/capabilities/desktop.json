{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "notification:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "opener:default",
    "process:default",
    "core:app:default"
  ]
}
