{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTask",
  "version": "0.1.0",
  "identifier": "com.offside.opentask",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenTask",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1QjlEQzMzNEFDMzMzNUIKUldSYk04TktNOXk1bGROYW9vQUttTUl5cGtOb1I3ZmJ1cnJBUkpUUnFzV2VMSmp4MFNwZFNVNTUK",
      "endpoints": [
        "https://github.com/Offside-Software/OpenTask/releases/latest/download/latest.json"
      ]
    }
  }
}
